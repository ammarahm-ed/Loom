diff --git a/packages/rn-tester/android/app/src/main/java/com/facebook/react/uiapp/NativeTextBenchmarkActivity.kt b/packages/rn-tester/android/app/src/main/java/com/facebook/react/uiapp/NativeTextBenchmarkActivity.kt
new file mode 100644
index 0000000000000000000000000000000000000000..23c71cb3183ed4daaf60d25c3a2678db2e3ff2ed
--- /dev/null
+++ b/packages/rn-tester/android/app/src/main/java/com/facebook/react/uiapp/NativeTextBenchmarkActivity.kt
@@ -0,0 +1,85 @@
+package com.facebook.react.uiapp
+
+import android.app.Activity
+import android.graphics.Color
+import android.os.Bundle
+import android.os.SystemClock
+import android.util.Log
+import android.view.View
+import android.widget.GridLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+
+private const val ITEM_COUNT = 180
+private const val COMMIT_COUNT = 30
+
+public class NativeTextBenchmarkActivity : Activity() {
+  private lateinit var sentinel: View
+  private lateinit var cells: Array<TextView>
+  private var nextCommit = 1
+  private var submittedAt = 0L
+  private var totalLatency = 0.0
+  private var started = false
+
+  override fun onCreate(savedInstanceState: Bundle?) {
+    super.onCreate(savedInstanceState)
+    val root = LinearLayout(this).apply {
+      orientation = LinearLayout.VERTICAL
+      setPadding(8, 8, 8, 8)
+    }
+    root.addView(TextView(this).apply {
+      text = "Native Android text commit stress"
+      textSize = 16f
+      setTextColor(Color.BLACK)
+    })
+    sentinel = View(this)
+    root.addView(sentinel, LinearLayout.LayoutParams(1, 1))
+    val grid = GridLayout(this).apply { columnCount = 10 }
+    cells = Array(ITEM_COUNT) { index ->
+      TextView(this).apply {
+        textSize = 9f
+        setTextColor(Color.WHITE)
+        gravity = android.view.Gravity.CENTER
+        layoutParams = GridLayout.LayoutParams().apply {
+          width = 58
+          height = 38
+          setMargins(2, 2, 2, 2)
+        }
+      }.also(grid::addView)
+    }
+    root.addView(grid)
+    sentinel.addOnLayoutChangeListener { _, _, _, _, _, _, _, _, _ -> completeCommit() }
+    setContentView(root)
+    root.post {
+      started = true
+      Log.i("RNXNativeStress", "start")
+      submitCommit()
+    }
+  }
+
+  private fun submitCommit() {
+    if (!started || submittedAt != 0L) return
+    submittedAt = SystemClock.elapsedRealtimeNanos()
+    cells.forEachIndexed { index, cell ->
+      cell.text = "$nextCommit:$index"
+      cell.setBackgroundColor(if ((index + nextCommit) % 2 == 0) Color.rgb(79, 124, 172) else Color.rgb(158, 197, 171))
+    }
+    sentinel.layoutParams = sentinel.layoutParams.apply { width = 1 + (nextCommit and 1) }
+    sentinel.requestLayout()
+  }
+
+  private fun completeCommit() {
+    if (submittedAt == 0L) return
+    val latency = (SystemClock.elapsedRealtimeNanos() - submittedAt) / 1_000_000.0
+    totalLatency += latency
+    Log.i("RNXNativeStress", "commit id=$nextCommit latency=${"%.2f".format(latency)}")
+    if (nextCommit == COMMIT_COUNT) {
+      Log.i("RNXNativeStress", "end duration=${"%.2f".format(totalLatency)} commits=$COMMIT_COUNT completed=layout")
+      submittedAt = 0L
+    } else {
+      nextCommit++
+      submittedAt = 0L
+      sentinel.post(::submitCommit)
+    }
+  }
+}
