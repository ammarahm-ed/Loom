diff --git a/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/FabricColorPureUpdateDiagnosticExample.js b/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/FabricColorPureUpdateDiagnosticExample.js
new file mode 100644
index 0000000000000000000000000000000000000000..b15ac9468f047b6bf0366279c36dfe937e10ade7
--- /dev/null
+++ b/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/FabricColorPureUpdateDiagnosticExample.js
@@ -0,0 +1,114 @@
+/**
+ * @flow strict-local
+ * @format
+ */
+
+'use strict';
+
+import * as React from 'react';
+import {StyleSheet, Text, View} from 'react-native';
+
+const ITEM_COUNT = 180;
+const COMMIT_COUNT = 30;
+
+function FabricColorPureUpdateDiagnostic(): React.Node {
+  const [commit, setCommit] = React.useState(0);
+  const nextCommit = React.useRef(1);
+  const completedCommit = React.useRef(0);
+  const submittedAt = React.useRef({});
+  const totalLatency = React.useRef(0);
+  const timer = React.useRef<?IntervalID>(null);
+
+  React.useEffect(() => {
+    submittedAt.current[1] = global.performance.now();
+    console.log(
+      `RNXPureColor: submit id=1 t=${submittedAt.current[1].toFixed(2)}`,
+    );
+    setCommit(1);
+    return () => {
+      if (timer.current != null) clearTimeout(timer.current);
+    };
+  }, []);
+
+  // In the UI-thread renderer, completeRoot applies the native batch
+  // synchronously before React runs layout effects. This provides a per-commit
+  // completion signal without a changing onLayout sentinel or any extra host
+  // view in the committed tree.
+  React.useLayoutEffect(() => {
+    if (commit === 0 || completedCommit.current >= commit) return;
+
+    completedCommit.current = commit;
+    const completedAt = global.performance.now();
+    const submitTime = submittedAt.current[commit];
+    if (submitTime == null) return;
+    const latency = completedAt - submitTime;
+    totalLatency.current += latency;
+    console.log(
+      `RNXPureColor: commit id=${commit} submit=${submitTime.toFixed(2)} ` +
+        `complete=${completedAt.toFixed(2)} latency=${latency.toFixed(2)}`,
+    );
+
+    if (commit === COMMIT_COUNT) {
+      console.log(
+        `RNXPureColor: end duration=${totalLatency.current.toFixed(2)} ` +
+          `commits=${COMMIT_COUNT} completed=layout-effect-after-commitRoot`,
+      );
+      return;
+    }
+
+    nextCommit.current = commit + 1;
+    timer.current = setTimeout(() => {
+      const next = nextCommit.current;
+      submittedAt.current[next] = global.performance.now();
+      console.log(
+        `RNXPureColor: submit id=${next} t=${submittedAt.current[next].toFixed(2)}`,
+      );
+      setCommit(next);
+    }, 0);
+  }, [commit]);
+
+  const items = [];
+  for (let index = 0; index < ITEM_COUNT; index += 1) {
+    items.push(
+      <View
+        key={index}
+        style={[
+          styles.item,
+          {
+            backgroundColor: (index + commit) % 2 === 0 ? '#4f7cac' : '#9ec5ab',
+          },
+        ]}>
+        <Text style={styles.label}>{`${index}`}</Text>
+      </View>,
+    );
+  }
+
+  return (
+    <View style={styles.container}>
+      <Text style={styles.title}>Pure color update diagnostic</Text>
+      <View style={styles.grid}>{items}</View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: {flex: 1, padding: 8, backgroundColor: '#101418'},
+  title: {fontSize: 16, fontWeight: 'bold', marginBottom: 8},
+  grid: {flexDirection: 'row', flexWrap: 'wrap'},
+  item: {
+    width: 58,
+    height: 38,
+    margin: 2,
+    justifyContent: 'center',
+    alignItems: 'center',
+  },
+  label: {fontSize: 9, color: 'white'},
+});
+
+export default {
+  title: 'Fabric Pure Color Update Diagnostic',
+  description:
+    'Same 180 color-changing views without a replacing onLayout sentinel.',
+  Bad: FabricColorPureUpdateDiagnostic,
+  Good: FabricColorPureUpdateDiagnostic,
+};
