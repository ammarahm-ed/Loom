diff --git a/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/FabricCommitStressExample.js b/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/FabricCommitStressExample.js
new file mode 100644
index 0000000000000000000000000000000000000000..f3c39166a111c6d63a1a6a7e6cd4da48203742e2
--- /dev/null
+++ b/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/FabricCommitStressExample.js
@@ -0,0 +1,222 @@
+/**
+ * @flow strict-local
+ * @format
+ */
+
+'use strict';
+
+import * as React from 'react';
+import {StyleSheet, Text, View} from 'react-native';
+
+const ITEM_COUNT = 1000;
+const COMMIT_COUNT = 30;
+
+export function FabricCommitStress({
+  variant = 'full',
+}: {
+  variant?: string,
+}): React.Node {
+  const [commit, setCommit] = React.useState(0);
+  const [result, setResult] = React.useState<?{
+    latencySum: number,
+    wall: number,
+  }>(null);
+  const resultRef = React.useRef(false);
+  const startedAt = React.useRef<?number>(null);
+  const nextCommit = React.useRef(1);
+  const completedCommit = React.useRef(0);
+  const completedCommits = React.useRef({});
+  const submittedAt = React.useRef({});
+  const totalCommitLatency = React.useRef(0);
+  const timer = React.useRef<?IntervalID>(null);
+  const renderStartedAt = global.performance.now();
+
+  React.useEffect(
+    () => () => {
+      if (timer.current != null) {
+        clearTimeout(timer.current);
+      }
+    },
+    [],
+  );
+
+  // Submit each queued update from the preceding commit's layout effect so
+  // React Native timer/display cadence does not throttle the benchmark.
+  const submitQueuedCommit = React.useCallback(() => {
+    const next = nextCommit.current++;
+    if (next > COMMIT_COUNT) {
+      return;
+    }
+    submittedAt.current[next] = global.performance.now();
+    console.log(
+      `RNXStress: submit id=${next} t=${submittedAt.current[next].toFixed(2)}`,
+    );
+    setCommit(next);
+  }, []);
+
+  // In queued mode, submit the next distinct React commit as soon as the
+  // preceding React commit has reached its layout effects. A timer here makes
+  // this benchmark wait for React Native's timer/display cadence between
+  // commits, which prevents the worker pool from ever receiving a backlog.
+  React.useLayoutEffect(() => {
+    if (variant === 'queued' && commit > 0 && commit < COMMIT_COUNT) {
+      submitQueuedCommit();
+    }
+  }, [commit, submitQueuedCommit, variant]);
+
+  const onCommitMounted = React.useCallback(
+    (mountedCommit: number) => {
+      // Finish the initial tree before timing updates. Its async mount can
+      // otherwise overlap update 1 and inflate that commit's latency.
+      if (startedAt.current == null) {
+        if (mountedCommit !== 0) {
+          return;
+        }
+        startedAt.current = global.performance.now();
+        console.log(`RNXStress: start t=${startedAt.current.toFixed(2)}`);
+        if (variant === 'queued') {
+          submitQueuedCommit();
+          return;
+        }
+        submittedAt.current[1] = global.performance.now();
+        console.log(
+          `RNXStress: submit id=1 t=${submittedAt.current[1].toFixed(2)}`,
+        );
+        setCommit(1);
+        return;
+      }
+      if (variant === 'queued') {
+        // Acknowledging the final sentinel gives the queued and synchronous
+        // builds the same end-to-end endpoint; intermediate native events can
+        // legitimately arrive after a newer sentinel has replaced them.
+        if (mountedCommit === COMMIT_COUNT && !resultRef.current) {
+          const completedAt = global.performance.now();
+          const wall = completedAt - startedAt.current;
+          resultRef.current = true;
+          console.log(
+            `RNXStress: end wall=${wall.toFixed(2)} commits=${COMMIT_COUNT} completed=mount variant=${variant}`,
+          );
+        }
+        return;
+      }
+      // Worker layout events can reach JS after a later result is ready. Count
+      // only the sentinel created by the update whose mount is being measured.
+      if (
+        mountedCommit <= 0 ||
+        mountedCommit > COMMIT_COUNT ||
+        completedCommits.current[mountedCommit]
+      ) {
+        return;
+      }
+      const commitId = mountedCommit;
+      const submitTime = submittedAt.current[commitId];
+      if (submitTime == null) {
+        return;
+      }
+      completedCommits.current[commitId] = true;
+      completedCommit.current += 1;
+      const completedAt = global.performance.now();
+      const latency = completedAt - submitTime;
+      totalCommitLatency.current += latency;
+      console.log(
+        `RNXStress: commit id=${commitId} submit=${submitTime.toFixed(2)} complete=${completedAt.toFixed(2)} latency=${latency.toFixed(2)}`,
+      );
+      if (completedCommit.current === COMMIT_COUNT) {
+        const wall = completedAt - startedAt.current;
+        const latencySum = totalCommitLatency.current;
+        resultRef.current = true;
+        setResult({latencySum, wall});
+        console.log(
+          `RNXStress: end latencySum=${latencySum.toFixed(2)} wall=${wall.toFixed(2)} commits=${COMMIT_COUNT} completed=mount variant=${variant}`,
+        );
+        return;
+      }
+      if (variant !== 'queued') {
+        nextCommit.current += 1;
+        timer.current = setTimeout(() => {
+          submittedAt.current[nextCommit.current] = global.performance.now();
+          console.log(
+            `RNXStress: submit id=${nextCommit.current} t=${submittedAt.current[nextCommit.current].toFixed(2)}`,
+          );
+          setCommit(nextCommit.current);
+        }, 0);
+      }
+    },
+    [submitQueuedCommit, variant],
+  );
+
+  const items = [];
+  for (let index = 0; index < ITEM_COUNT; index += 1) {
+    items.push(
+      <View
+        key={index}
+        style={[
+          styles.item,
+          variant === 'text'
+            ? styles.item
+            : {
+                backgroundColor:
+                  (index + commit) % 2 === 0 ? '#4f7cac' : '#9ec5ab',
+              },
+        ]}>
+        <Text style={styles.label}>
+          {variant === 'color' ? `${index}` : `${commit}:${index}`}
+        </Text>
+      </View>,
+    );
+  }
+
+  if (commit > 0) {
+    const renderEndedAt = global.performance.now();
+    console.log(
+      `RNXStress: render id=${commit} start=${renderStartedAt.toFixed(2)} end=${renderEndedAt.toFixed(2)} duration=${(renderEndedAt - renderStartedAt).toFixed(2)}`,
+    );
+  }
+
+  return (
+    <View style={styles.container}>
+      <Text style={styles.title}>Fabric commit stress</Text>
+      {result != null ? (
+        <Text
+          accessibilityLabel={`${COMMIT_COUNT} commits mounted, latency sum ${result.latencySum.toFixed(1)} ms, wall ${result.wall.toFixed(1)} ms`}
+          style={styles.result}>
+          {`${COMMIT_COUNT} commits mounted · latency sum ${result.latencySum.toFixed(1)} ms · wall ${result.wall.toFixed(1)} ms`}
+        </Text>
+      ) : null}
+      <View
+        key={`rnx-commit-sentinel-${commit}`}
+        accessibilityLabel={`rnx-commit-${commit}`}
+        onLayout={() => onCommitMounted(commit)}
+        style={{width: 1 + (commit % 2), height: 1}}
+      />
+      <View style={styles.grid}>{items}</View>
+    </View>
+  );
+}
+
+const title = 'Fabric Commit Stress';
+const description = 'Deterministic large mount and repeated commit workload.';
+
+const styles = StyleSheet.create({
+  // Keep the unfilled text-only variant legible without changing its per-item
+  // props or the benchmark workload.
+  container: {flex: 1, padding: 8, backgroundColor: '#101418'},
+  title: {fontSize: 16, fontWeight: 'bold', marginBottom: 8},
+  result: {fontSize: 12, color: 'white', marginBottom: 8},
+  grid: {flexDirection: 'row', flexWrap: 'wrap'},
+  item: {
+    width: 58,
+    height: 38,
+    margin: 2,
+    justifyContent: 'center',
+    alignItems: 'center',
+  },
+  label: {fontSize: 9, color: 'white'},
+});
+
+export default {
+  title,
+  description,
+  Bad: FabricCommitStress,
+  Good: FabricCommitStress,
+};
