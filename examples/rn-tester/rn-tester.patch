diff --git a/packages/rn-tester/js/__tests__/fixtures/AsyncDirectRendererWorkerRegression.js b/packages/rn-tester/js/__tests__/fixtures/AsyncDirectRendererWorkerRegression.js
new file mode 100644
index 0000000000000000000000000000000000000000..423cdc057f2e107db572dfcf8a55d738629a7c67
--- /dev/null
+++ b/packages/rn-tester/js/__tests__/fixtures/AsyncDirectRendererWorkerRegression.js
@@ -0,0 +1,94 @@
+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * This source code is licensed under the MIT license found in the LICENSE file.
+ * @format
+ */
+// Standalone bundle entry for worker-mode device regression checks.
+import * as React from 'react';
+import {
+  AppRegistry,
+  Animated,
+  LayoutAnimation,
+  ScrollView,
+  Text,
+  TextInput,
+  View,
+} from 'react-native';
+function Verification() {
+  const view = React.useRef(null);
+  const opacity = React.useRef(new Animated.Value(1)).current;
+  const [step, setStep] = React.useState(0);
+  React.useEffect(() => {
+    if (step === 0) {
+      view.current.setNativeProps({style: {width: 87, opacity: 0.5}});
+      setStep(1);
+    } else if (step === 1) {
+      setTimeout(
+        () =>
+          view.current.measure((x, y, width) => {
+            console.log(
+              `RNXAsyncRegression: nativePropsRetained=${width === 87} width=${width}`,
+            );
+            view.current.setNativeProps({style: {width: null}});
+            const force =
+              global.nativeFabricUIManager.unstable_forceNextCommitSync;
+            if (typeof force === 'function') force();
+            setStep(2);
+          }),
+        50,
+      );
+    } else if (step === 2) {
+      view.current.measure((x, y, width) => {
+        console.log(
+          `RNXAsyncRegression: resetAndSync=${width === 120} width=${width}`,
+        );
+        LayoutAnimation.configureNext(
+          LayoutAnimation.Presets.easeInEaseOut,
+          () => console.log('RNXAsyncRegression: layoutAnimationSuccess'),
+          () => console.log('RNXAsyncRegression: layoutAnimationRejected'),
+        );
+        setStep(3);
+        Animated.timing(opacity, {
+          toValue: 0.2,
+          duration: 400,
+          useNativeDriver: true,
+        }).start(({finished}) =>
+          console.log(`RNXAsyncRegression: nativeAnimatedFinished=${finished}`),
+        );
+      });
+    }
+  }, [step, opacity]);
+  return (
+    <View style={{paddingTop: 80, width: 300, height: 700}}>
+      <View
+        ref={view}
+        style={{
+          width: step < 2 ? 100 : 120,
+          height: 30,
+          backgroundColor: step === 1 ? 'blue' : 'red',
+        }}
+      />
+      <Animated.View
+        style={{width: 100, height: 30, opacity, backgroundColor: 'green'}}
+      />
+      <TextInput
+        testID="async-worker-input"
+        style={{width: 250, height: 50}}
+        placeholder="Worker input"
+        onChangeText={text => console.log(`RNXAsyncRegression: input=${text}`)}
+      />
+      <ScrollView
+        testID="async-worker-scroll"
+        style={{width: 250, height: 300}}
+        onScroll={() => console.log('RNXAsyncRegression: scrollEvent')}
+        scrollEventThrottle={16}>
+        {Array.from({length: 40}, (_, i) => (
+          <Text key={i} style={{height: 30}}>
+            Worker row {i}
+          </Text>
+        ))}
+      </ScrollView>
+    </View>
+  );
+}
+AppRegistry.registerComponent('RNTesterApp', () => Verification);
