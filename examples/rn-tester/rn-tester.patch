diff --git a/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/TextHeavyFlatListExample.js b/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/TextHeavyFlatListExample.js
new file mode 100644
index 0000000000000000000000000000000000000000..40d1299bb3dcf57b96fea093621bd82f339e0b74
--- /dev/null
+++ b/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/TextHeavyFlatListExample.js
@@ -0,0 +1,152 @@
+/**
+ * @flow strict-local
+ * @format
+ */
+
+'use strict';
+
+import * as React from 'react';
+import {FlatList, StyleSheet, Text, View} from 'react-native';
+
+const ITEM_COUNT = 600;
+const DATA = Array.from({length: ITEM_COUNT}, (_, index) => ({
+  id: String(index),
+  title: `Everyday text item ${index + 1}`,
+  body:
+    `This is plain paragraph text in a virtualized list. Item ${index + 1} ` +
+    'contains ordinary words that wrap naturally to the available width, as ' +
+    'they do in a typical feed or settings screen.',
+}));
+
+const VIEWABILITY_CONFIG = {itemVisiblePercentThreshold: 10};
+
+function TextRow({
+  item,
+}: {
+  item: {id: string, title: string, body: string},
+}): React.Node {
+  return (
+    <View style={styles.row}>
+      <Text style={styles.title}>{item.title}</Text>
+      <Text style={styles.body}>{item.body}</Text>
+    </View>
+  );
+}
+
+function TextHeavyFlatListExample(): React.Node {
+  const scrollStartedAt = React.useRef(0);
+  const lastScrollAt = React.useRef(0);
+  const scrollEventCount = React.useRef(0);
+  const largestScrollEventGap = React.useRef(0);
+  const seenItems = React.useRef(new Set<string>());
+
+  const onScrollBeginDrag = React.useCallback(() => {
+    scrollStartedAt.current = global.performance.now();
+    lastScrollAt.current = 0;
+    scrollEventCount.current = 0;
+    largestScrollEventGap.current = 0;
+    seenItems.current.clear();
+    console.log(
+      `RNXTextList: scroll-start t=${scrollStartedAt.current.toFixed(2)}`,
+    );
+  }, []);
+
+  const onScroll = React.useCallback(
+    (event: {nativeEvent: {contentOffset: {y: number}}}) => {
+      const now = global.performance.now();
+      if (lastScrollAt.current !== 0) {
+        largestScrollEventGap.current = Math.max(
+          largestScrollEventGap.current,
+          now - lastScrollAt.current,
+        );
+      }
+      lastScrollAt.current = now;
+      scrollEventCount.current += 1;
+      // Sample rather than logging each event; detailed renderer timings come
+      // from RNXRendererProfile and RNXDirectMountProfile in profiled releases.
+      if (scrollEventCount.current % 30 === 0) {
+        console.log(
+          `RNXTextList: scroll-sample events=${scrollEventCount.current} ` +
+            `offset=${event.nativeEvent.contentOffset.y.toFixed(0)} ` +
+            `maxEventGap=${largestScrollEventGap.current.toFixed(1)}ms`,
+        );
+      }
+    },
+    [],
+  );
+
+  const onViewableItemsChanged = React.useRef(
+    ({
+      changed,
+    }: {
+      changed: Array<{isViewable?: boolean, item: {id: string}}>,
+    }): void => {
+      for (const token of changed) {
+        if (token.isViewable) {
+          seenItems.current.add(token.item.id);
+        }
+      }
+    },
+  ).current;
+
+  const reportScrollEnd = React.useCallback(() => {
+    const endedAt = global.performance.now();
+    console.log(
+      `RNXTextList: scroll-end duration=${(endedAt - scrollStartedAt.current).toFixed(1)}ms ` +
+        `events=${scrollEventCount.current} uniqueItems=${seenItems.current.size} ` +
+        `maxEventGap=${largestScrollEventGap.current.toFixed(1)}ms`,
+    );
+  }, []);
+
+  return (
+    <FlatList
+      data={DATA}
+      renderItem={({item}) => <TextRow item={item} />}
+      keyExtractor={item => item.id}
+      ListHeaderComponent={
+        <View style={styles.header}>
+          <Text style={styles.headerTitle}>Text-heavy FlatList</Text>
+          <Text style={styles.headerHint}>
+            600 plain-text rows. Swipe and fling to profile text measurement and
+            mounting while rows enter the virtualized window.
+          </Text>
+        </View>
+      }
+      onScrollBeginDrag={onScrollBeginDrag}
+      onScroll={onScroll}
+      onScrollEndDrag={reportScrollEnd}
+      onMomentumScrollEnd={reportScrollEnd}
+      onViewableItemsChanged={onViewableItemsChanged}
+      viewabilityConfig={VIEWABILITY_CONFIG}
+      scrollEventThrottle={16}
+      initialNumToRender={12}
+      maxToRenderPerBatch={8}
+      windowSize={9}
+      removeClippedSubviews
+      style={styles.list}
+    />
+  );
+}
+
+const styles = StyleSheet.create({
+  list: {flex: 1, backgroundColor: '#f7f8fa'},
+  header: {paddingHorizontal: 16, paddingTop: 16, paddingBottom: 12},
+  headerTitle: {fontSize: 18, fontWeight: '600', color: '#17212b'},
+  headerHint: {fontSize: 13, lineHeight: 18, color: '#4a5560', marginTop: 6},
+  row: {
+    paddingHorizontal: 16,
+    paddingVertical: 12,
+    borderBottomWidth: StyleSheet.hairlineWidth,
+    borderBottomColor: '#d9dee3',
+  },
+  title: {fontSize: 15, fontWeight: '500', color: '#17212b'},
+  body: {fontSize: 14, lineHeight: 20, color: '#4a5560', marginTop: 4},
+});
+
+export default {
+  title: 'Text-Heavy FlatList Scroll',
+  description:
+    'Profile plain-text preparation and row mounting during virtualized scrolling.',
+  Bad: TextHeavyFlatListExample,
+  Good: TextHeavyFlatListExample,
+};
diff --git a/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/index.js b/packages/rn-tester/js/examples/Performance/performanceComparisonExamples/index.js
