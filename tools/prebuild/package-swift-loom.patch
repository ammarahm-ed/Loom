+// Loom: compile-time switches of the published configuration, same names and meaning as the
+// Loom podspecs (RCT_LOOM_*_IOS). The renderer is off unless RCT_LOOM_RENDERER_IOS=1; the worker
+// defaults to on with the renderer; JavaScript runs on `background` unless RCT_LOOM_JS_IOS=main.
+let LOOM_RENDERER = ProcessInfo.processInfo.environment["RCT_LOOM_RENDERER_IOS"] == "1"
+let LOOM_WORKER =
+  LOOM_RENDERER
+  && (ProcessInfo.processInfo.environment["RCT_LOOM_WORKER_IOS"].map { $0 == "1" } ?? true)
+let LOOM_JS_ON_MAIN = (ProcessInfo.processInfo.environment["RCT_LOOM_JS_IOS"] ?? "background") == "main"
+// Prebuild (tools/prebuild/ios.sh), every flavor: Fabric's renderer internals are not compiled under the Loom
+// renderer, every export of React Native's own binary of the same flavor is still exported by a generated stub
+// target (tools/prebuild/gen-export-stubs-ios.py): RCT_LOOM_STUBS_IOS=1. RCT_LOOM_STUBS_PASS1_IOS=1 is the first of
+// the two passes (no stubs, unresolved names tolerated, to learn which exports have no code).
+// RCT_LOOM_LEAN_RELEASE_IOS=1 (Release only) also drops the inspector, DevTools and tracing code;
+// RCT_LOOM_PROFILING_IOS=1 is Release with DevTools and tracing kept (not lean).
+let LOOM_STUBS = LOOM_RENDERER && ProcessInfo.processInfo.environment["RCT_LOOM_STUBS_IOS"] == "1"
+let LOOM_LEAN = ProcessInfo.processInfo.environment["RCT_LOOM_LEAN_RELEASE_IOS"] == "1"
+let LOOM_STUBS_PASS1 = ProcessInfo.processInfo.environment["RCT_LOOM_STUBS_PASS1_IOS"] == "1"
+let LOOM_PROFILING = ProcessInfo.processInfo.environment["RCT_LOOM_PROFILING_IOS"] == "1"
+// Release flavors only (set by tools/prebuild/ios.sh): `.when(configuration:)` is not honored for linker
+// unsafeFlags of a package product, which stripped the Debug core's local symbols too.
+let LOOM_STRIP_LOCALS = ProcessInfo.processInfo.environment["RCT_LOOM_STRIP_LOCALS_IOS"] == "1"
+let LOOM_STUBS_PATH = "loom-stubs"  // written by tools/prebuild/ios.sh: loom_export_stubs.S, stub.c, include/
+
+/// The .cpp/.mm files directly in `dir` (relative to the package root) that are not in `keep`.
+func loomLeanExcludeSources(_ dir: String, keeping keep: [String]) -> [String] {
+  let root = URL(fileURLWithPath: #filePath).deletingLastPathComponent().appendingPathComponent(dir).path
+  let names = (try? FileManager.default.contentsOfDirectory(atPath: root)) ?? []
+  return names.filter { ($0.hasSuffix(".cpp") || $0.hasSuffix(".mm")) && !keep.contains($0) }.sorted()
+}
+
+/// Sources left out of the target at `path` in a lean Release (paths relative to that target).
+func loomLeanExcludes(_ path: String) -> [String] {
+  switch path {
+  case "ReactCommon/jsinspector-modern" where LOOM_LEAN:
+    return loomLeanExcludeSources(path, keeping: ["FallbackRuntimeTargetDelegate.cpp", "InspectorFlags.cpp", "LoomLeanStubs.cpp"])
+  case "ReactCommon/jsinspector-modern/tracing" where LOOM_LEAN:
+    return loomLeanExcludeSources(path, keeping: ["EventLoopReporter.cpp"])
+  case "ReactCommon/jsinspector-modern/network" where LOOM_LEAN:
+    return loomLeanExcludeSources(path, keeping: ["HttpUtils.cpp"])
+  case "ReactCommon/react/renderer" where LOOM_STUBS:
+    // Fabric's renderer under the Loom renderer: Loom mounts, diffs and animates through its own renderer.
+    return [
+      "mounting/Differentiator.cpp", "mounting/updateMountedFlag.cpp", "mounting/stubs",
+      "mounting/internal/sliceChildShadowNodeViewPairs.cpp", "mounting/internal/CullingContext.cpp",
+      "animations/LayoutAnimationDriver.cpp", "animations/LayoutAnimationKeyFrameManager.cpp", "animations/utils.cpp",
+      "viewtransition/ViewTransitionModule.cpp",
+    ]
+  default:
+    return []
+  }
+}
