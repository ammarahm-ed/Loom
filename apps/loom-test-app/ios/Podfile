# Loom: materialize node_modules/.loom/react-native (= pristine react-native +
# overrides) and resolve react_native_pods.rb from that tree. Loom also forces
# RCT_USE_PREBUILT_RNCORE=0, because the overrides patch React-Core sources and
# prebuilt RN core binaries cannot contain them.
#
# LOOM_BENCH_STOCK=1: the stock baseline for bench/run-ios.js. Uses the pristine
# node_modules/react-native with its default prebuilt React Native core, as a
# normal app would, and none of the Loom integration.
#
# Loom iOS switches (read by the Loom podspecs at `pod install` time):
#   RCT_LOOM_RENDERER_IOS=1   draw with the Loom renderer
#   RCT_LOOM_WORKER_IOS=1     prepare commits on a worker thread
#   RCT_LOOM_JS_IOS=main|background
#                             JavaScript on the main thread (default) or on React
#                             Native's own JS thread; background requires the worker
if ENV['LOOM_BENCH_STOCK'] == '1'
  RN_PATH = File.expand_path('../node_modules/react-native', __dir__)
  require File.join(RN_PATH, 'scripts/react_native_pods')
else
  require_relative '../node_modules/react-native-loom/integration/ios/loom_pods'
  RN_PATH = Loom.react_native_path(__dir__)
  require File.join(RN_PATH, 'scripts/react_native_pods')
end

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'LoomTestApp' do
  config = use_native_modules!

  use_react_native!(
    :path => RN_PATH,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      RN_PATH,
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end