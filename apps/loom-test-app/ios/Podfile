# Loom: materialize node_modules/.loom/react-native (= pristine react-native +
# overrides) and resolve react_native_pods.rb from that tree. Loom also forces
# RCT_USE_PREBUILT_RNCORE=0, because the overrides patch React-Core sources and
# prebuilt RN core binaries cannot contain them.
require_relative '../node_modules/react-native-loom/integration/ios/loom_pods'
require File.join(Loom.react_native_path(__dir__), 'scripts/react_native_pods')

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'LoomTestApp' do
  config = use_native_modules!

  use_react_native!(
    :path => Loom.react_native_path(__dir__),
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      Loom.react_native_path(__dir__),
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end